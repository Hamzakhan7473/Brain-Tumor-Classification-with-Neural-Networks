# Brain Tumor CNN — Environment Variables
# Copy to .env and fill in values

# Kaggle API (for dataset download)
KAGDLE_USERNAME=your_kaggle_username
KAGDLE_KEY=your_kaggle_api_key

# ----------------------------
# LLM providers
# ----------------------------
# Provider resolution: LLM_PROVIDER wins; otherwise Bedrock when
# BEDROCK_MODEL_ID is set, else Gemini when GOOGLE_API_KEY is set.
# LLM_PROVIDER=bedrock

# Amazon Bedrock (HIPAA-eligible under the AWS BAA — preferred for PHI)
# Credentials resolve via the standard boto3 chain (env / profile / IAM role).
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# AWS_REGION=us-east-1
# Optional Guardrail (contextual grounding — secondary net under the
# deterministic clinical validator). Create with:
#   python scripts/create_bedrock_guardrail.py
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# BEDROCK_GROUNDING_THRESHOLD=0.75
# BEDROCK_RELEVANCE_THRESHOLD=0.75

# Optional chain-of-verification (Prompt 4). Default OFF — adds a second
# LLM pass that splits the draft into atomic claims and checks each against
# the grounding payload. Recommended ON for pilot/production.
# CONTRADICTED claims fail closed (same Tier 0 path as the deterministic gate).
# NOT_ADDRESSED_BY_PAYLOAD claims are logged for human review, not hard-failed.
# ENABLE_CHAIN_OF_VERIFICATION=false

# Bedrock model-invocation logging (S3 + CloudWatch). Enable with:
#   python scripts/enable_bedrock_invocation_logging.py --dry-run
# BEDROCK_AUDIT_BUCKET=neurosight-bedrock-audit-logs
# BEDROCK_AUDIT_LOG_GROUP=/neurosight/bedrock-invocations
# BEDROCK_AUDIT_KEY_PREFIX=invocations/
# BEDROCK_LOGGING_ROLE_NAME=NeuroSightBedrockLoggingDelivery
# BEDROCK_AUDIT_KMS_KEY_ARN=
# Prompt template versions are code-pinned in src/llm/versions.py (bump by hand).
# BEDROCK_MODEL_ID is the model version pin — never set it to "latest".

# Google AI (Gemini) — research fallback for explanations and chat
GOOGLE_API_KEY=your_google_api_key

# Optional: other LLM providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# PageIndex (vectorless RAG for Docs Assistant — primary retrieval)
# PAGEINDEX_API_KEY=

# REST API (optional — require clients to send X-API-Key when set)
# Single key:
# API_KEY=your_long_random_secret
# Or multiple (comma-separated) for partners:
# API_KEYS=key_for_site_a,key_for_site_b

# Paths (optional overrides)
# DATA_DIR=data/raw
# MODEL_DIR=models/saved

# ----------------------------
# MongoDB Atlas (events + RAG)
# ----------------------------
# Enable MongoDB integration when set.
MONGODB_URI=your_mongodb_atlas_uri
MONGODB_DB=brain_tumor_ai

# Collections
MONGODB_COLLECTION_INFERENCE=inference_events
MONGODB_COLLECTION_FEEDBACK=clinical_feedback
MONGODB_COLLECTION_RAG=rag_chunks
MONGODB_COLLECTION_AUTHS=prior_auths
MONGODB_COLLECTION_INBOX=inbox_messages
MONGODB_COLLECTION_TRACES=agent_traces
MONGODB_COLLECTION_TRIALS=clinical_trials
MONGODB_COLLECTION_TRIAL_CANDIDATES=trial_candidates
MONGODB_COLLECTION_AUDIT_LOG=audit_log
MONGODB_COLLECTION_SHADOW_CASES=shadow_cases

# Atlas Vector Search index name (must exist in Atlas)
MONGODB_RAG_VECTOR_INDEX=rag_vector_index

# Embeddings model for RAG
# (Default in code: models/text-embedding-004)
RAG_EMBED_MODEL=models/text-embedding-004

# Feature flags (JSONL fallback)
MONGO_ENABLE=true
ENABLE_JSONL_AUDIT=true
ENABLE_JSONL_SHADOW=true
ENABLE_JSONL_CLINICAL_FEEDBACK=true

# CORS (browser frontend)
# Extra origin appended automatically when set (in addition to CORS_ALLOW_ORIGINS / defaults).
# FRONTEND_URL=http://localhost:5173
# Match frontend VITE_API_KEY when requiring auth:
# APP_API_KEY=your-test-key
# API_KEY=your-test-key

# Comma-separated list of allowed origins. If unset, defaults to local Vite dev URLs.
# Example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# ----------------------------
# 3D volumes (NIfTI) inference
# ----------------------------
# Default crop/pad shape for 3D volumes, as "D,H,W"
VOLUME_3D_SHAPE=96,96,96
# Optional separate model directory for 3D
# MODEL_DIR_3D=models/saved
