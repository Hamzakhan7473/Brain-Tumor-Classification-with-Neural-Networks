# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.

# Optional: full backend URL (production or remote demo).
# Leave unset during local dev to use /api proxy → http://127.0.0.1:8000
# VITE_API_BASE_URL=http://localhost:8000

# When the API has API_KEY / API_KEYS set, put the same secret here:
# VITE_API_KEY=your_key
